# Use Supabase's transaction pooler for the app runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use Supabase's session pooler for migrations.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only. Required for users to permanently delete their own Auth account.
# Never prefix this value with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: connect a JSON endpoint for customized spending tips.
SMART_TIPS_API_URL=""
SMART_TIPS_API_KEY=""
