# Use Supabase's transaction pooler for the app runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use the direct Supabase connection for migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Optional: connect any OpenAI-compatible JSON endpoint for model-written insights.
AI_INSIGHTS_API_URL=""
AI_INSIGHTS_API_KEY=""
